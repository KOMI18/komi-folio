NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://komi:komi@localhost:5433/komi_folio
# Générer avec : openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
# URL publique de l'API (sert à construire l'URL des images uploadées)
PUBLIC_URL=http://localhost:4000
# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000
# Front Next.js : utilisé pour la revalidation ISR après chaque modification dans l'admin
FRONT_URL=http://localhost:3000
REVALIDATE_SECRET=change-me
UPLOAD_DIR=./uploads
# Création automatique du compte admin au démarrage s'il n'en existe aucun
ADMIN_EMAIL=tehemparfait@gmail.com
ADMIN_PASSWORD=
# Optionnel : notification email des messages de contact (Resend)
RESEND_API_KEY=
RESEND_FROM=Portfolio <no-reply@invity.site>
CONTACT_TO_EMAIL=tehemparfait@gmail.com
# Synthèse vocale Kokoro-FastAPI pour le mode écoute (vide = voix du navigateur uniquement)
# En prod : service interne Dokploy, ex. http://komi-tts-xxxx:8880 ; en local : docker run -p 8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu:v0.9.0
TTS_URL=
TTS_VOICE=ff_siwis
