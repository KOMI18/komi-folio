generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum AudioStatus {
  NONE
  PENDING
  READY
  FAILED
}

model Post {
  id             String      @id @default(cuid())
  slug           String      @unique
  title          String
  excerpt        String
  content        String
  coverImage     String?
  tags           String[]
  status         PostStatus  @default(DRAFT)
  featured       Boolean     @default(false)
  seoTitle       String?
  seoDescription String?
  readingMinutes Int         @default(1)
  views          Int         @default(0)
  // Mode écoute : MP3 généré par Kokoro + minutage de chaque phrase
  audioStatus    AudioStatus @default(NONE)
  audioUrl       String?
  audioTimeline  Json?
  audioHash      String?
  audioError     String?
  publishedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, publishedAt])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String?
  tags        String[]
  demoUrl     String?
  githubUrl   String?
  featured    Boolean  @default(false)
  visible     Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id          String    @id @default(cuid())
  company     String
  role        String
  logo        String?
  link        String?
  location    String?
  description String
  tags        String[]
  color       String    @default("#7c6cf0")
  startDate   DateTime
  endDate     DateTime?
  visible     Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum SkillCategory {
  FRONTEND
  BACKEND
  TOOLS
}

model Skill {
  id          String        @id @default(cuid())
  name        String
  category    SkillCategory
  icon        String?
  description String?
  experience  String?
  mastery     String?
  showInHero  Boolean       @default(false)
  visible     Boolean       @default(true)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Education {
  id          String   @id @default(cuid())
  title       String
  level       String
  period      String
  description String
  visible     Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum EventType {
  HACKATHON
  COMPETITION
  CONFERENCE
}

model Event {
  id           String    @id @default(cuid())
  title        String
  type         EventType
  date         String
  location     String?
  position     String?
  project      String?
  url          String?
  attendees    String?
  teamSize     Int?
  tech         String[]
  achievements String[]
  description  String
  image        String?
  isWinner     Boolean   @default(false)
  visible      Boolean   @default(true)
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
